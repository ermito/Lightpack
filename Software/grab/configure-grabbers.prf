# Grabber types detection
# Linux/UNIX platform
unix:!macx {
    contains(DEFINES, WAYLAND_GRAB_SUPPORT) {
        SUPPORTED_GRABBERS += WAYLAND_GRAB_SUPPORT
    }
    contains(DEFINES, X11_GRAB_SUPPORT) {
        SUPPORTED_GRABBERS += X11_GRAB_SUPPORT
    }
    # If neither is explicitly defined, default to X11
    !contains(DEFINES, WAYLAND_GRAB_SUPPORT) {
        !contains(DEFINES, X11_GRAB_SUPPORT) {
            SUPPORTED_GRABBERS += X11_GRAB_SUPPORT
        }
    }
}

# Mac platform
macx {
    SUPPORTED_GRABBERS += MAC_OS_CG_GRAB_SUPPORT
    SUPPORTED_GRABBERS += MAC_OS_AV_GRAB_SUPPORT
}

# Windows platform
win32 {
    SUPPORTED_GRABBERS += WINAPI_GRAB_SUPPORT
    SUPPORTED_GRABBERS += DDUPL_GRAB_SUPPORT
    SUPPORTED_GRABBERS += D3D10_GRAB_SUPPORT
}
